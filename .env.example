# Firebase web app config for project gugu2-36268.
# The web app is not registered yet: register it in the Firebase console
# (Project settings > Your apps > Add app > Web) and copy the values here into `.env.local`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gugu2-36268.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gugu2-36268
VITE_FIREBASE_STORAGE_BUCKET=gugu2-36268.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Analytics is not used by the storefront)
VITE_FIREBASE_MEASUREMENT_ID=

# Public origin of the storefront, used for canonical URLs, Open Graph and sitemap.xml
VITE_SITE_URL=https://gugu-shop.web.app

# Local development against the Firebase Emulator Suite (auth 9099, firestore 8080,
# functions 5001, storage 9199). With this on, the project id defaults to demo-gugu.
VITE_USE_EMULATORS=false
# Optional: non-default emulator ports, e.g. auth:29099,firestore:28080,functions:25001,storage:29199
VITE_EMULATOR_PORTS=
